# ─────────────────────────────────────────────────────────────
# ReachInbox backend environment
# Copy to .env and fill in the values.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# Public URL of this backend (used for OAuth redirect URIs / links)
API_PUBLIC_URL=http://localhost:4000
# URL of the frontend (redirect target after login / Slack connect)
WEB_APP_URL=http://localhost:5173

# ── Database (PostgreSQL) ────────────────────────────────────
# Pooled connection used by the app. For Neon, append &pgbouncer=true.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public
# Direct (non-pooled) connection used by Prisma migrations.
# For Neon this is the same host WITHOUT "-pooler". Optional for local Postgres.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/reachinbox?schema=public

# ── Redis (required by BullMQ) ───────────────────────────────
# A plain ioredis URL. Works with local Redis or a cloud URL (Upstash/Redis Cloud).
REDIS_URL=redis://127.0.0.1:6379

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ── Google OAuth ─────────────────────────────────────────────
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ── Slack OAuth ──────────────────────────────────────────────
# api.slack.com/apps -> OAuth & Permissions (scopes: chat:write, incoming-webhook)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ── Elasticsearch ────────────────────────────────────────────
# Cloud (recommended) or local node. Leave empty to disable ES (app still runs;
# search falls back to Postgres). Indexing is non-fatal when ES is unreachable.
ELASTIC_NODE=
ELASTIC_API_KEY=
ELASTIC_INDEX=emails

# Optional: comma-separated DNS servers to retry FAILED lookups against, for
# environments whose router/ISP DNS refuses specific hosts (e.g. *.elastic.cloud
# causing "getaddrinfo ENOTFOUND"). Empty = use the OS resolver only.
DNS_SERVERS=

# ── Scheduler / worker tuning ────────────────────────────────
# Parallel jobs processed per worker instance.
WORKER_CONCURRENCY=5
# Minimum spacing between two sends from the SAME sender (ms).
EMAIL_MIN_DELAY_MS=2000
# Hourly send cap per sender (Redis-backed, safe across workers/instances).
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Global hourly cap across all senders. 0 disables the global cap.
MAX_EMAILS_PER_HOUR=0
# How many times a failed send is retried by BullMQ before being marked FAILED.
EMAIL_MAX_ATTEMPTS=3
# BullMQ limiter (max jobs per duration) applied to the whole worker.
WORKER_LIMITER_MAX=0
WORKER_LIMITER_DURATION_MS=1000
# Expose the live BullMQ dashboard at /admin/queues
ENABLE_BULL_BOARD=true

# ── Ethereal SMTP (fake SMTP for testing) ────────────────────
# Leave blank to auto-create ephemeral Ethereal accounts for seed senders.
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
# Optional fixed account (otherwise one is generated per sender at seed time).
ETHEREAL_USER=
ETHEREAL_PASS=
